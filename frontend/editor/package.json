{
  "name": "cwi-editor",
  "version": "0.1.0",
  "description": "Caption With Intention — Manual Editor UI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --proxy-config vite.proxy.config.json",
    "dev:api": "python ../../engine/editor/server.py",
    "start": "python ../../engine/editor/start.py",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "echo 'lint skipped (no eslint config)'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^1.6.0"
  }
}
